:80 {
    encode gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /ws/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle_path /media/* {
        file_server {
            root /baserow/media/
        }
    }

    handle_path /static/* {
        file_server {
            root /baserow/static/
        }
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}